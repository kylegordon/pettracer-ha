FROM python:3.14-slim

WORKDIR /workspace

# Install pettracer-client at the version pinned in manifest.json, in the
# same resolver pass as the test deps (mirrors the CI test job).
COPY requirements-test.txt .
COPY custom_components/pettracer/manifest.json .
RUN pip install --no-cache-dir -r requirements-test.txt \
    $(python -c "import json; print(' '.join(json.load(open('manifest.json'))['requirements']))")
RUN python -c "import pettracer"

COPY . .
